# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=db_aq_gis

# Web server
PORT=3001

# External API keys
# Open-Meteo does not require an API key.
# Leave GOOGLE_AQ_API_KEY blank to disable Google AQ ingestion and heatmap tiles.
GOOGLE_AQ_API_KEY=

# Scheduler
# Local development runs the internal scheduler. Production uses Cloud Scheduler.
FETCH_INTERVAL_HOURS=1

# Production refresh endpoint
# Production requests to POST /api/admin/refresh must provide this value in the
# X-Refresh-Token header. Use a long random value.
REFRESH_TOKEN=

# Data retention
# Full per-kecamatan detail is stored for this many days. Older rows are averaged
# into permanent daily city-level rollups before deletion.
KECAMATAN_RETENTION_DAYS=30
