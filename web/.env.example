# ──────────────────────────────────────────────
# MySQL Database
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=db_aq_gis

# ──────────────────────────────────────────────
# Web Server
# ──────────────────────────────────────────────
PORT=3001

# ──────────────────────────────────────────────
# External API Keys
# ──────────────────────────────────────────────

# Open-Meteo: free, no key needed — leave blank
# OPEN_METEO_API_KEY=

# Google Air Quality API
# Get yours at: https://console.cloud.google.com → APIs & Services → Air Quality API
# Leave blank to disable Google AQ fetching (scheduler will skip it gracefully)
GOOGLE_AQ_API_KEY=

# BMKG (Indonesian Meteorological Agency) — reserved for future use
# BMKG_API_KEY=

# ──────────────────────────────────────────────
# Scheduler
# ──────────────────────────────────────────────
# How often to fetch fresh data from APIs (in hours). Default: 1
FETCH_INTERVAL_HOURS=1

# ──────────────────────────────────────────────
# Data Retention
# ──────────────────────────────────────────────
# Days to keep full per-kecamatan detail. Older rows are averaged to city-level then deleted.
KECAMATAN_RETENTION_DAYS=30
